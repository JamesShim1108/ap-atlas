+/* Figures use an opaque surface so the page grid never crosses an image caption. */
+.lesson-figure {
+  margin: 1.75rem 0;
+  padding: 1rem;
+  border: 1px solid var(--line);
+  border-radius: 7px;
+  background: var(--white);
+}
+
+.lesson-figure__enlarge {
+  display: block;
+}
+
+.lesson-figure img {
+  display: block;
+  width: 100%;
+  height: auto;
+  border-radius: 3px;
+}
+
+.lesson-figure figcaption {
+  margin-top: 0.875rem;
+  color: var(--ink);
+  font-size: 0.9375rem;
+  line-height: 1.6;
+}
+
+.lesson-figure figcaption small {
