+}
+.guide-surface h2 {
+  font-size: 2rem;
+  line-height: 1.2;
+  margin-bottom: 22px;
+}
+.guide-timeline {
+  margin: 0;
+}
+.guide-timeline > div {
+  display: grid;
+  grid-template-columns: 130px minmax(0, 1fr);
+  gap: 24px;
+  padding: 18px 0;
+  border-bottom: 1px solid var(--line);
